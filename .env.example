# Hostinger → Node.js app → Environment variables.
#
# Next.js อ่าน NEXT_PUBLIC_* ตอน build — ตั้งค่าตัวแปรเหล่านี้ในแผง Hostinger แล้วค่อยกด Deploy
# (ถ้าใส่หลัง build เซิร์ฟเวอร์อาจไม่เห็นค่า → ไม่มีหน้าล็อกอิน / ไม่พาไป login)
#
# Next.js โหลดค่าในเบราว์เซอร์ได้เฉพาะที่ขึ้นต้นด้วย NEXT_PUBLIC_
# → ควรใส่คู่นี้เสมอ (ค่าเดียวกับ Supabase Project URL + anon key)

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ถ้า Hostinger / คู่มือให้ใช้ชื่อนี้แทน — โปรเจกต์นี้รองรับบน middleware / route เซิร์ฟเวอร์
# (หน้า Login ในเบราว์เซอร์ยังต้องมีคู่ NEXT_PUBLIC_* ด้านบน)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- จำกัดเฉพาะอีเมลที่อนุญาต (ไม่ใช้ env) ---
# รัน SQL ใน supabase/migrations/002_email_allowlist.sql แล้วใน SQL Editor ใส่เมล เช่น:
# insert into public.allowed_emails (email) values ('you@domain.com');
# ถ้าตารางว่าง = ไม่จำกัดเมล | มีอย่างน้อย 1 แถว = เฉพาะเมลในลิสต์เท่านั้น
#
# --- หน้าเว็บจัดการการเข้าถึง (/admin/access) ---
# รัน supabase/migrations/003_admin_access.sql
# รัน supabase/migrations/004_first_admin_bootstrap.sql → เปิดแอปแล้วใช้แบนเนอร์「ตั้งเป็นแอดมินคนแรก」
# หรือตั้งมือ: update public.profiles set role = 'admin' where lower(trim(email)) = 'you@domain.com';
