# Hostinger → Node.js app → Environment variables.
#
# Next.js อ่าน NEXT_PUBLIC_* ตอน build — ตั้งค่าตัวแปรเหล่านี้ในแผง Hostinger แล้วค่อยกด Deploy
# (ถ้าใส่หลัง build เซิร์ฟเวอร์อาจไม่เห็นค่า → ไม่มีหน้าล็อกอิน / ไม่พาไป login)
#
# Next.js โหลดค่าในเบราว์เซอร์ได้เฉพาะที่ขึ้นต้นด้วย NEXT_PUBLIC_
# → ควรใส่คู่นี้เสมอ (ค่าเดียวกับ Supabase Project URL + anon key)

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ถ้า Hostinger / คู่มือให้ใช้ชื่อนี้แทน — โปรเจกต์นี้รองรับบน middleware / route เซิร์ฟเวอร์
# (หน้า Login ในเบราว์เซอร์ยังต้องมีคู่ NEXT_PUBLIC_* ด้านบน)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# โดเมนจริงของเว็บ (แนะนำบน Hostinger — กัน OAuth redirect ไป 0.0.0.0:3000)
# ใช้ชื่อใดชื่อหนึ่ง ค่าเดียวกัน:
# SITE_URL=https://your-domain.com
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- จำกัดเฉพาะอีเมลที่อนุญาต (ไม่ใช้ env) ---
# รัน migrations 002+ แล้วใน SQL Editor ใส่อย่างน้อยหนึ่งเมล (ถ้าตารางว่าง = ล็อกอินไม่ได้):
# insert into public.allowed_emails (email) values ('you@domain.com');
#
# --- หลังบ้าน (/admin) — ตาราง admin_emails (ไม่ใช้ profiles.role) ---
# หลังรัน migration 006: insert into public.admin_emails (email) values ('you@domain.com');
# จากนั้นจัดการต่อได้ที่หน้า /admin/admins
#
# Migrations แนะนำตามลำดับ: 001 … 007 (รวม 006_admin_emails_portal.sql และ 007_profiles_guard_portal_admin.sql)
